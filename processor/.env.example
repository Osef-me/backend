# PostgresSQL
DATABASE_URL=postgres://osef:osef@localhost:5432/osef

# osu! API v2 OAuth (https://osu.ppy.sh/home/account/edit#oauth)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Seeder
SEEDER_RATE=120            # req/min (10-200)
SEEDER_DUMP_PATH=seeds/osu_mania.sql
SEEDER_KEYS=4,7            # key counts to seed (4, 6, 7 — minacalc-supported)
SEEDER_LOG_DIR=logs        # crash log directory

# Server
PROCESSOR_ADDR=0.0.0.0:4000
ROX_PATH=/data/rox

# Logging
RUST_LOG=info
